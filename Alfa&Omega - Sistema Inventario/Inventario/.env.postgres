# .env.postgres — Variables de entorno para modo Postgres (Fase 3)
# Uso en PowerShell:
#   Get-Content .env.postgres | ForEach-Object { if ($_ -match '^([^#=]+)=(.*)') { [System.Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }
# O simplemente copiar las vars al shell.

DB_ENGINE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario
DB_USER=postgres
DB_PASS=dev_secret
TENANT_SCHEMA=public
SECRET_KEY=dev-only-secret-change-in-production-64chars-xx
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256
